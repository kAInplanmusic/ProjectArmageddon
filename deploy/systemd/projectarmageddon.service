# systemd-Einheit: ProjectArmageddon Spielserver
#
# VORLAGE — bewusst nicht installiert. Dieses Repo mietet nichts (AGENTS.md §5):
# Der Knoten, auf dem das hier liegt, ist eine Entscheidung des Auftraggebers.
#
# Platzhalter, die beim Aufsetzen ersetzt werden müssen (siehe
# docs/betrieb-INSTANZ.md, Abschnitt "Offene Punkte"):
#   /opt/projectarmageddon   Basis auf dem Knoten (releases/, current -> releases/<kennung>)
#   pa                       Systembenutzer ohne Anmeldung
#   /etc/projectarmageddon/betrieb.env   Abschaltparameter (Vorlage: deploy/betrieb.env.example)
#
# Aufbau (docs/deploy-plan.md, Abschnitt 4): Der Dienst läuft IMMER aus
# /opt/projectarmageddon/current — einem Symlink, den scripts/release/deploy.sh
# und rollback.sh atomar umhängen. Ein Neustart nimmt das neue Release auf.
#
# Einrichten (auf dem KNOTEN, nach dem Mieten; vollständig in docs/deploy-plan.md Abschnitt 5):
#   useradd --system --no-create-home --shell /usr/sbin/nologin pa
#   install -d /etc/projectarmageddon
#   cp deploy/betrieb.env.example /etc/projectarmageddon/betrieb.env   # Werte eintragen!
#   touch /etc/projectarmageddon/ist-gemietet    # schaltet die Bremse scharf
#   cp deploy/systemd/projectarmageddon*.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload
#   scripts/release/deploy.sh <paket.tar.gz>     # legt current an und startet neu
#   systemctl enable projectarmageddon.service
#   systemctl enable --now projectarmageddon-idle.timer
#
# NACHWEIS, dass die Bremse laufen wird (AGENTS.md §5 Punkt 3):
#   systemctl list-timers projectarmageddon-idle.timer
#   ls -l /etc/projectarmageddon/ist-gemietet
#   /opt/projectarmageddon/current/scripts/betrieb/idle-watch.sh --print-config
#   systemd-analyze security projectarmageddon.service

[Unit]
Description=ProjectArmageddon Spielserver (autoritativ)
Documentation=file:/opt/projectarmageddon/current/docs/deploy-plan.md
Documentation=file:/opt/projectarmageddon/current/docs/betrieb.md
Documentation=file:/opt/projectarmageddon/current/docs/betrieb-INSTANZ.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=pa
Group=pa
WorkingDirectory=/opt/projectarmageddon/current
EnvironmentFile=-/etc/projectarmageddon/betrieb.env
ExecStart=/opt/projectarmageddon/current/scripts/betrieb/server-start.sh

# Neustart nach einem Absturz — aber NICHT nach einem geordneten Stopp. Die
# Idle-Bremse stoppt genau so (`systemctl stop`), und systemd startet einen
# sauber beendeten Dienst nicht neu. Stünde hier "always", würde der Server
# jede Minute von der Bremse gestoppt und von systemd wieder gestartet.
Restart=on-failure
RestartSec=5

# Zeit für das geordnete Beenden: scripts/server.mjs speichert den Zustand
# (Seed + Eingaben) bei SIGTERM. Zu kurz abgeschnitten wäre der Zustand weg.
TimeoutStopSec=120
# Sicherung nach JEDEM Stopp (Idle-Bremse, manuelles Stoppen, Absturz, Herunterfahren):
# Spielstand, Replays, Journal, Programmstand -> /var/lib/projectarmageddon/snapshots,
# die neuesten PA_SNAPSHOT_KEEP bleiben, ältere werden gelöscht. Das Minuszeichen
# heißt: ein Fehlschlag der Sicherung blockiert das Stoppen NICHT (er steht im Journal).
ExecStopPost=-/opt/projectarmageddon/current/scripts/betrieb/snapshot.sh --grund "Dienst gestoppt (${SERVICE_RESULT})"
# Das Journal des Dienstes darf der Dienstbenutzer für die Sicherung lesen.
SupplementaryGroups=systemd-journal
KillMode=mixed

StateDirectory=projectarmageddon
StateDirectoryMode=0700
RuntimeDirectory=projectarmageddon
# Gruppe `pa` darf das Token lesen (token-setzen.sh legt es als root:pa 640 an); das Verzeichnis überlebt
# einen Dienststopp, sonst fehlte das Token genau im ExecStopPost und nach jedem Neustart.
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# HARTE OBERGRENZE (Ablaufdatum auf Prozessebene).
# Wenn das gesetzt wird, MUSS Restart auf "no" oder "on-abnormal" stehen —
# sonst startet systemd den Server nach Ablauf der Frist immer wieder neu und
# die Kosten laufen weiter. Die zweite, unabhängige Frist ist
# PA_MAX_MACHINE_MINUTES in deploy/betrieb.env.example (hängt am Knoten, nicht
# am Prozess).
#RuntimeMaxSec=10800

# Ohne Anmeldung und ohne TLS nach außen: nicht auf 0.0.0.0 binden, bevor ein
# Reverse-Proxy mit TLS davor steht (docs/betrieb.md, Abschnitt 3).
# Die Bindeadresse kommt aus HOST in /etc/projectarmageddon/betrieb.env.
Environment=HOST=127.0.0.1
# Release-Betrieb: dist/ liegt im Paket, gebaut wird auf dem Knoten nie (ohne devDependencies ginge es auch nicht).
Environment=PA_BUILD=0
Environment=NODE_ENV=production
# npm (server-start.sh startet `npm run server`) schreibt Cache und Protokolle; ohne Heimatverzeichnis
# und unter ProtectSystem=strict braucht es einen beschreibbaren Ort.
Environment=npm_config_cache=/var/cache/projectarmageddon/npm
Environment=npm_config_update_notifier=false
CacheDirectory=projectarmageddon
CacheDirectoryMode=0700

# Härtung (kostet nichts, hilft gegen die häufigsten Fälle).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/projectarmageddon
# Verschärfung (Audit 2026-10-13). NICHT gegen ein echtes systemd gelaufen — nach dem Aufsetzen prüfen:
#   systemd-analyze security projectarmageddon.service ; journalctl -u projectarmageddon -b
# `MemoryDenyWriteExecute` fehlt mit Absicht: Node (V8) braucht ausführbaren Speicher.
# Neue Dateien nur für den Dienstbenutzer lesbar (Zustandsdatei und Archive enthalten Spieler-Tokens).
UMask=0077
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# Deploy-Plan 2026-11-04: fremde Prozesse unsichtbar, IPC-Reste beim Stopp weg, kein Schlüsselbund geteilt.
ProtectProc=invisible
RemoveIPC=yes
KeyringMode=private
# Nur die Standardgruppe; eine strengere Liste (`~@privileged`) könnte tar/git/hcloud der Sicherung töten.
SystemCallFilter=@system-service
# Obergrenzen gegen Ressourcenerschöpfung (ein Kern, wenige GB Speicher; bei Bedarf anheben).
MemoryMax=1G
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
