# =============================================================================
#  ProjectArmageddon — Betriebsparameter für EINE gemietete Instanz
# =============================================================================
#  Diese Datei ist die VORLAGE. Sie wird beim Aufsetzen auf dem Knoten nach
#  /etc/systemd/system/../projectarmageddon/betrieb.env kopiert:
#
#      install -d /etc/projectarmageddon
#      cp deploy/betrieb.env.example /etc/projectarmageddon/betrieb.env
#
#  Beide Einheiten lesen sie über `EnvironmentFile=-/etc/projectarmageddon/betrieb.env`
#  (das Minus heißt: fehlt die Datei, gelten die Vorgaben im Skript).
#
#  ZWEI SORTEN VON ZEILEN
#  ----------------------
#    WERT      = vom Auftraggeber entschieden, hier eingetragen.
#    LÜCKE     = eine Entscheidung, die dieses Repo NICHT treffen darf.
#                Sie bleibt leer bzw. auskommentiert, bis der Auftraggeber sie
#                füllt. Siehe docs/betrieb-INSTANZ.md.
#  Nichts hier ist ein Kostenvorschlag: Preise stehen in docs/betrieb-INSTANZ.md.
# =============================================================================

# --- Server ------------------------------------------------------------------
# Bindeadresse. 127.0.0.1 = sicher (Vorgabe). Der Server hat KEINE Anmeldung
# und KEINE Verschlüsselung — 0.0.0.0 nur mit Reverse-Proxy mit TLS davor.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=json

# Ablage der Lobby-Daten. Muss unter dem liegen, was die Einheit schreiben darf
# (StateDirectory=projectarmageddon → /var/lib/projectarmageddon). Der
# Vorgabewert .pa-state/lobbies.json im Projektordner funktioniert unter
# `ProtectSystem=strict` NICHT.
PA_STATE_PATH=/var/lib/projectarmageddon/lobbies.json

# Öffentlich erreichbar: no | yes. Bei HOST != 127.0.0.1 bricht das Startskript
# ab, solange hier "no" steht. Das ist Absicht (docs/betrieb.md, Abschnitt 3).
PA_ERLAUBE_OEFFENTLICH=no

# Client vor dem Start bauen: auto (nur wenn dist/ fehlt) | 1 (immer) | 0 (nie)
PA_BUILD=auto

# --- Die Idle-Bremse (AGENTS.md §5 Punkt 2) ----------------------------------
# VORSCHLAG, vom Auftraggeber zu bestätigen oder zu ändern:
#   LÜCKE: PA_IDLE_MINUTES — ab wann gilt der Knoten als unbenutzt?
PA_IDLE_MINUTES=15

# VORSCHLAG, zu bestätigen:
#   LÜCKE: PA_GRACE_MINUTES — Anlaufschonfrist, damit ein frisch gestarteter
#   Server nicht sofort als unbenutzt gilt.
PA_GRACE_MINUTES=5

# VORSCHLAG, zu bestätigen:
#   LÜCKE: PA_MAX_RUNTIME_MINUTES — das Ablaufdatum des Prozesses. Greift
#   IMMER, auch bei offenen Verbindungen.
PA_MAX_RUNTIME_MINUTES=180

# LÜCKE: PA_MAX_MACHINE_MINUTES — das Ablaufdatum des KNOTENS (aus
# /proc/uptime). Das ist die einzige Frist, die auch dann greift, wenn der
# Server nie gestartet wurde — also der Fall "Maschine läuft, niemand nutzt
# sie". Solange hier nichts steht, ist diese Schicht AUS.
#PA_MAX_MACHINE_MINUTES=

# VORSCHLAG, zu bestätigen:
#   LÜCKE: PA_ACTION — stop (nur den Server stoppen) oder poweroff (den Knoten
#   abschalten). Nur "poweroff" beendet die KOSTEN; "stop" beendet nur den
#   Dienst. AGENTS.md §7 (harte Bremse) spricht für poweroff — die Entscheidung
#   gehört dem Auftraggeber.
PA_ACTION=stop

# Wenn PA_ACTION=poweroff: eine zweite, ausdrückliche Bestätigung. Ohne "yes"
# schaltet die Bremse den Knoten NICHT ab (sie stoppt nur den Server und
# schreibt das ins Journal).
PA_POWEROFF_CONFIRM=no

# Wartezeit zwischen "Bremse greift" und dem Abschalten des Knotens. Gibt einem
# gerade verbundenen Client noch die Chance, die letzte Meldung zu sehen.
PA_POWEROFF_DELAY_SECONDS=30

# Takt der Bremse. Im Timer-Modus (--once) ohne Bedeutung.
PA_INTERVAL_SECONDS=30

# --- Namen und Orte ----------------------------------------------------------
PA_SYSTEMD_UNIT=projectarmageddon.service
PA_STATE_DIR=/var/lib/projectarmageddon

# LÜCKE: PA_ARMED_FILE — der Marker, ohne den die Bremse NICHT SCHARF ist.
# Vorgabe /etc/projectarmageddon/ist-gemietet ist bewusst: siehe
# docs/betrieb-INSTANZ.md, Abschnitt "Scharfschaltung".
PA_ARMED_FILE=/etc/projectarmageddon/ist-gemietet

PA_HEALTH_URL=http://127.0.0.1:3000/healthz

# --- Sicherung vor dem Abschalten (scripts/betrieb/snapshot.sh) -----------------
# Ablage der Snapshots (liegt im Zustandsverzeichnis des Dienstes).
PA_SNAPSHOT_DIR=/var/lib/projectarmageddon/snapshots
# Wie viele Snapshots bleiben (die NEUESTEN). Ältere werden gelöscht — erst nachdem
# der neue vollständig und lesbar da ist. Erlaubt: 1 bis 50.
PA_SNAPSHOT_KEEP=3
# Journal-Zeitraum im Archiv (Tage).
PA_SNAPSHOT_LOG_TAGE=14
# Bilder/Videos mit ins Archiv? "no" = nur über den git-Hash wiederherstellbar
# (Archiv ~1 MB statt vieler hundert MB).
PA_SNAPSHOT_MIT_ASSETS=no
# Hetzner-Abbild des ganzen Servers vor dem Abschalten (yes|no). Nur das überlebt
# das LÖSCHEN des Servers. Braucht die hcloud-CLI, HCLOUD_TOKEN (Projekt-Token mit
# Lese-/Schreibrecht) und den Servernamen. Das Token gehört NUR in diese Datei
# (Rechte 600, Besitzer root) — nie ins Repo.
PA_SNAPSHOT_CLOUD=no
PA_HCLOUD_SERVER=LÜCKE
#HCLOUD_TOKEN=LÜCKE
