# systemd-Einheit: Starter für den Spielserver auf Abruf (läuft auf „brain“, nicht bei Hetzner).
# Installation: docs/starter-installation.md. Platzhalter: /opt/pa-starter (Repo-Klon), Benutzer pa-starter.
[Unit]
Description=ProjectArmageddon Starter (Login + Hochfahren/Status/Not-aus)
After=network-online.target
Wants=network-online.target

[Service]
User=pa-starter
Group=pa-starter
WorkingDirectory=/opt/pa-starter
# Enthält HCLOUD_TOKEN, Passwort-Hash und Geheimnis. Rechte 0600, Besitzer root (systemd liest sie als root).
EnvironmentFile=/etc/pa-starter/starter.env
ExecStart=/usr/bin/env node /opt/pa-starter/scripts/betrieb/starter/starter.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
